#!/usr/bin/env python3
"""
docx-to-pdf-viewer:
Seamlessly converts Word/Office documents (.docx, .doc, .pptx, .xlsx, .odt, .rtf) to PDF
and opens them in the system PDF viewer with smart caching and a GUI loading dialog.
"""

import sys
import os
import shutil
import subprocess
import hashlib
from urllib.parse import urlparse, unquote
from pathlib import Path


def clean_path(raw_arg: str) -> str:
    """Normalize file:// URLs and relative paths to absolute file paths."""
    if raw_arg.startswith("file://"):
        parsed = urlparse(raw_arg)
        path = unquote(parsed.path)
    else:
        path = raw_arg
    return os.path.abspath(os.path.expanduser(path))


def show_error(message: str, title: str = "Document Viewer Error"):
    """Show an error message via zenity or notify-send."""
    if shutil.which("zenity"):
        subprocess.run(
            ["zenity", "--error", f"--title={title}", f"--text={message}", "--width=380"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    elif shutil.which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", title, message])
    print(f"[{title}] {message}", file=sys.stderr)


def get_converter_command():
    """Find available LibreOffice/soffice executable (native or flatpak)."""
    native_soffice = shutil.which("soffice") or shutil.which("libreoffice")
    if native_soffice:
        return [native_soffice]

    flatpak = shutil.which("flatpak")
    if flatpak:
        # Check user or system flatpak
        res = subprocess.run(
            [flatpak, "info", "org.libreoffice.LibreOffice"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if res.returncode == 0:
            return [flatpak, "run", "org.libreoffice.LibreOffice"]

    return None


def get_pdf_viewer():
    """Find installed PDF viewer."""
    for viewer in ["evince", "okular", "atril", "zathura", "xdg-open"]:
        path = shutil.which(viewer)
        if path:
            return path
    return "xdg-open"


def convert_and_view(file_path: str):
    if not os.path.exists(file_path):
        show_error(f"File not found:\n{file_path}")
        return

    # Cache setup
    cache_base = os.path.expanduser("~/.cache/docx-pdf-viewer")
    os.makedirs(cache_base, exist_ok=True)

    try:
        stat = os.stat(file_path)
    except OSError as e:
        show_error(f"Cannot read file:\n{e}")
        return

    # Unique hash based on real path, modification time, and size
    key_str = f"{os.path.realpath(file_path)}:{stat.st_mtime_ns}:{stat.st_size}"
    key_hash = hashlib.sha256(key_str.encode("utf-8")).hexdigest()[:16]

    file_stem = Path(file_path).stem
    doc_cache_dir = os.path.join(cache_base, f"{file_stem}_{key_hash}")
    cached_pdf = os.path.join(doc_cache_dir, f"{file_stem}.pdf")

    pdf_viewer = get_pdf_viewer()

    # Fast Path: Cache hit! (Instant open <0.15s)
    if os.path.isfile(cached_pdf) and os.path.getsize(cached_pdf) > 0:
        subprocess.Popen([pdf_viewer, cached_pdf], start_new_session=True)
        return

    # Slow Path: Need conversion
    converter_cmd = get_converter_command()
    if not converter_cmd:
        show_error(
            "LibreOffice conversion engine not found.\n\n"
            "Please install LibreOffice via your package manager or Flatpak:\n"
            "flatpak install --user flathub org.libreoffice.LibreOffice\n"
            "or: sudo pacman -S libreoffice-fresh (Arch)\n"
            "or: sudo apt install libreoffice (Ubuntu/Debian)"
        )
        return

    os.makedirs(doc_cache_dir, exist_ok=True)

    # Show loading progress dialog
    zenity_proc = None
    if shutil.which("zenity"):
        try:
            zenity_proc = subprocess.Popen(
                [
                    "zenity",
                    "--progress",
                    "--pulsate",
                    "--title=Opening Document",
                    f"--text=Converting '{os.path.basename(file_path)}' to PDF...\nPlease wait a moment.",
                    "--no-cancel",
                    "--auto-close",
                    "--width=380",
                ],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            zenity_proc = None
    elif shutil.which("notify-send"):
        subprocess.run(
            [
                "notify-send",
                "-a",
                "Document Viewer",
                "Converting Document",
                f"Converting '{os.path.basename(file_path)}' to PDF...",
            ]
        )

    # Execute conversion
    cmd = converter_cmd + [
        "--headless",
        "--convert-to",
        "pdf",
        file_path,
        "--outdir",
        doc_cache_dir,
    ]

    try:
        conv = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=60,
            text=True,
        )
        success = conv.returncode == 0 and os.path.isfile(cached_pdf) and os.path.getsize(cached_pdf) > 0
    except subprocess.TimeoutExpired:
        success = False
        conv_error = "Conversion timed out after 60 seconds."
    except Exception as e:
        success = False
        conv_error = str(e)
    finally:
        # Dismiss loading dialog
        if zenity_proc and zenity_proc.poll() is None:
            zenity_proc.terminate()
            try:
                zenity_proc.wait(timeout=1)
            except Exception:
                zenity_proc.kill()

    if success:
        # Open PDF in viewer
        subprocess.Popen([pdf_viewer, cached_pdf], start_new_session=True)
    else:
        err_detail = ""
        if 'conv_error' in locals():
            err_detail = conv_error
        elif 'conv' in locals() and conv.stderr:
            err_detail = conv.stderr.strip()
        show_error(f"Failed to convert '{os.path.basename(file_path)}' to PDF.\n{err_detail}")


def main():
    if len(sys.argv) < 2:
        # If launched directly without args, show file chooser
        if shutil.which("zenity"):
            res = subprocess.run(
                [
                    "zenity",
                    "--file-selection",
                    "--title=Select Office Document to View",
                    "--file-filter=Office Documents (*.docx *.doc *.pptx *.ppt *.xlsx *.xls *.odt *.rtf) | *.docx *.doc *.pptx *.ppt *.xlsx *.xls *.odt *.rtf",
                    "--file-filter=All Files | *",
                ],
                stdout=subprocess.PIPE,
                text=True,
            )
            if res.returncode == 0 and res.stdout.strip():
                convert_and_view(clean_path(res.stdout.strip()))
        else:
            print("Usage: docx-to-pdf-viewer <file.docx> ...", file=sys.stderr)
        return

    for raw_arg in sys.argv[1:]:
        convert_and_view(clean_path(raw_arg))


if __name__ == "__main__":
    main()
